{
  "description": "kharos: launches through RemoteTrigger get the stored routine body, answers about routines in the registry are recorded, classified and shortened, a run the auto mode classifier refused goes back to unfired, the watcher session may only read, and at every turn end an open session that no follower reads gets a follower process. Every other RemoteTrigger call passes untouched.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "RemoteTrigger",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/kharos",
              "hook",
              "pre-tool-use"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "RemoteTrigger",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/kharos",
              "hook",
              "post-tool-use"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "RemoteTrigger",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/kharos",
              "hook",
              "post-tool-use-failure"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "RemoteTrigger",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/kharos",
              "hook",
              "permission-denied"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/kharos",
              "hook",
              "session-start"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/kharos",
              "hook",
              "stop"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
